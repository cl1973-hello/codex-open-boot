{
  "name": "codex-open-boot",
  "version": "2.1.0",
  "description": "Animated splash screen + UI theme injected into the real Codex desktop client",
  "private": true,
  "main": "src/main/main.js",
  "author": "cl1973-hello",
  "license": "MIT",
  "homepage": "https://github.com/cl1973-hello/codex-open-boot",
  "repository": {
    "type": "git",
    "url": "https://github.com/cl1973-hello/codex-open-boot.git"
  },
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "dev": "node scripts/dev.mjs",
    "build:renderer": "node scripts/build-renderer.mjs",
    "test": "node --test test/geometry.test.js test/validate.test.js test/portal.test.js test/theme-css.test.js test/media.test.js test/watcher.test.js",
    "probe": "node scripts/probe.mjs",
    "check:entry": "electron scripts/check-entry.cjs",
    "pack": "npm run build:renderer && electron-builder --win --dir",
    "dist": "npm run build:renderer && electron-builder --win"
  },
  "dependencies": {
    "koffi": "^3.3.8"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  }
}
