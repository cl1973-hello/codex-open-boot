{
  "name": "codex-open-boot",
  "version": "1.0.0",
  "description": "Animated splash screen + themeable workbench launcher for the Codex desktop client",
  "private": true,
  "main": "src/main/main.js",
  "author": "cl1973-hello",
  "license": "MIT",
  "homepage": "https://github.com/cl1973-hello/codex-open-boot",
  "repository": {
    "type": "git",
    "url": "https://github.com/cl1973-hello/codex-open-boot.git"
  },
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "dev": "node scripts/dev.mjs",
    "build:renderer": "node scripts/build-renderer.mjs",
    "test": "node --test test/geometry.test.js test/validate.test.js",
    "pack": "npm run build:renderer && electron-builder --win --dir",
    "dist": "npm run build:renderer && electron-builder --win",
    "demo": "node scripts/capture-demo.mjs"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "^5.3.0"
  }
}
